{
  "name": "@fitness/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@better-auth/expo": "^1.7.5",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "dev:tunnel": "expo start --dev-client --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "android:device": "expo run:android --device",
    "ios:device": "expo run:ios --device",
    "build:development:android": "npx eas-cli@latest build --profile development --platform android",
    "build:development:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:production:android": "npx eas-cli@latest build --profile production --platform android",
    "build:production:ios": "npx eas-cli@latest build --profile production --platform ios",
    "eas:build": "npx eas-cli@latest build",
    "eas:submit": "npx eas-cli@latest submit",
    "build": "expo export --platform web",
    "lint": "expo lint",
    "check-types": "tsc --noEmit"
  },
  "private": true
}
